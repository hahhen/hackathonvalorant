{
  "type": "object",
  "properties": {
    "schemaVersion": {
      "enum": [
        "1.0.0",
        "1.1.0"
      ]
    },
    "mode": {
      "enum": [
        "computed",
        "example"
      ]
    },
    "matchId": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "object",
      "properties": {
        "fileName": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "fileName",
        "sha256"
      ],
      "additionalProperties": false
    },
    "engine": {
      "type": "object",
      "properties": {
        "version": {
          "type": "string",
          "minLength": 1
        },
        "catalogVersion": {
          "type": "integer",
          "minimum": 0
        },
        "configVersion": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "version",
        "catalogVersion",
        "configVersion"
      ],
      "additionalProperties": false
    },
    "coverage": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/coverage"
      }
    },
    "occurrences": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/occurrence"
      }
    },
    "recommendations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/recommendation"
      }
    }
  },
  "required": [
    "schemaVersion",
    "mode",
    "matchId",
    "source",
    "engine",
    "coverage",
    "occurrences",
    "recommendations"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://afterplant.local/schemas/analysis-result.schema.json",
  "$defs": {
    "coverage": {
      "type": "object",
      "properties": {
        "detectorId": {
          "type": "string",
          "minLength": 1
        },
        "detectorVersion": {
          "type": "string",
          "minLength": 1
        },
        "target": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "kind": {
                  "const": "team"
                },
                "teamId": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "kind",
                "teamId"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "const": "player"
                },
                "teamId": {
                  "type": "string",
                  "minLength": 1
                },
                "playerId": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "kind",
                "teamId",
                "playerId"
              ],
              "additionalProperties": false
            }
          ]
        },
        "period": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "kind": {
                  "const": "match"
                }
              },
              "required": [
                "kind"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "const": "round"
                },
                "roundNumber": {
                  "type": "integer",
                  "minimum": 1
                }
              },
              "required": [
                "kind",
                "roundNumber"
              ],
              "additionalProperties": false
            }
          ]
        },
        "status": {
          "enum": [
            "complete",
            "partial",
            "not_evaluable",
            "not_implemented"
          ]
        },
        "sample": {
          "type": "object",
          "properties": {
            "unit": {
              "enum": [
                "round",
                "death",
                "opening",
                "plant",
                "match"
              ]
            },
            "eligible": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0
                },
                {
                  "type": "null"
                }
              ]
            },
            "evaluated": {
              "type": "integer",
              "minimum": 0
            },
            "flagged": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "unit",
            "eligible",
            "evaluated",
            "flagged"
          ],
          "additionalProperties": false
        },
        "reasons": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "detectorId",
        "detectorVersion",
        "target",
        "period",
        "status",
        "sample",
        "reasons"
      ],
      "additionalProperties": false
    },
    "occurrence": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "detectorId": {
          "type": "string",
          "minLength": 1
        },
        "detectorVersion": {
          "type": "string",
          "minLength": 1
        },
        "target": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "kind": {
                  "const": "team"
                },
                "teamId": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "kind",
                "teamId"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "const": "player"
                },
                "teamId": {
                  "type": "string",
                  "minLength": 1
                },
                "playerId": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "kind",
                "teamId",
                "playerId"
              ],
              "additionalProperties": false
            }
          ]
        },
        "period": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "kind": {
                  "const": "match"
                }
              },
              "required": [
                "kind"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "const": "round"
                },
                "roundNumber": {
                  "type": "integer",
                  "minimum": 1
                }
              },
              "required": [
                "kind",
                "roundNumber"
              ],
              "additionalProperties": false
            }
          ]
        },
        "roundNumbers": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1
          }
        },
        "participantIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "basis": {
          "enum": [
            "measured",
            "inferred"
          ]
        },
        "observation": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "eventId": {
                "type": "string",
                "minLength": 1
              },
              "roundNumber": {
                "type": "integer",
                "minimum": 1
              },
              "sourcePath": {
                "type": "string",
                "minLength": 1
              },
              "values": {
                "type": "object",
                "additionalProperties": {
                  "type": [
                    "string",
                    "number",
                    "boolean",
                    "null"
                  ]
                }
              }
            },
            "required": [
              "roundNumber",
              "sourcePath",
              "values"
            ],
            "additionalProperties": false
          }
        },
        "definition": {
          "type": "object",
          "properties": {
            "rule": {
              "type": "string",
              "minLength": 1
            },
            "parameters": {
              "type": "object",
              "additionalProperties": {
                "type": [
                  "string",
                  "number",
                  "boolean",
                  "null"
                ]
              }
            }
          },
          "required": [
            "rule",
            "parameters"
          ],
          "additionalProperties": false
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "id",
        "detectorId",
        "detectorVersion",
        "target",
        "period",
        "roundNumbers",
        "participantIds",
        "basis",
        "observation",
        "evidence",
        "definition",
        "limitations"
      ],
      "additionalProperties": false
    },
    "recommendation": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "tipId": {
          "type": "string",
          "minLength": 1
        },
        "target": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "kind": {
                  "const": "team"
                },
                "teamId": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "kind",
                "teamId"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "const": "player"
                },
                "teamId": {
                  "type": "string",
                  "minLength": 1
                },
                "playerId": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "kind",
                "teamId",
                "playerId"
              ],
              "additionalProperties": false
            }
          ]
        },
        "period": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "kind": {
                  "const": "match"
                }
              },
              "required": [
                "kind"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "const": "round"
                },
                "roundNumber": {
                  "type": "integer",
                  "minimum": 1
                }
              },
              "required": [
                "kind",
                "roundNumber"
              ],
              "additionalProperties": false
            }
          ]
        },
        "observation": {
          "type": "string",
          "minLength": 1
        },
        "occurrenceIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "roundNumbers": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1
          }
        },
        "sample": {
          "type": "object",
          "properties": {
            "unit": {
              "enum": [
                "round",
                "death",
                "opening",
                "plant",
                "match"
              ]
            },
            "eligible": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0
                },
                {
                  "type": "null"
                }
              ]
            },
            "evaluated": {
              "type": "integer",
              "minimum": 0
            },
            "flagged": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "unit",
            "eligible",
            "evaluated",
            "flagged"
          ],
          "additionalProperties": false
        },
        "priority": {
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "priorityReasons": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "id",
        "tipId",
        "target",
        "period",
        "observation",
        "occurrenceIds",
        "roundNumbers",
        "sample",
        "priority",
        "priorityReasons",
        "limitations"
      ],
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "mode": {
            "const": "computed"
          }
        }
      },
      "then": {
        "properties": {
          "source": {
            "properties": {
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          }
        }
      }
    }
  ]
}
